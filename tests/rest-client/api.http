Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "category_id": 1,
  "is_active": true,
  "name": "New Test Product",
  "price": 12345.67,
  "stock": 100
}


### 

# @name getProductById

GET {{baseUrl}}/products/1 HTTP/1.1


### 

# @name updateProduct

PUT {{baseUrl}}/products/1 HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "price": 99999.99,
  "stock": 50
}


### 

# @name deleteProduct

DELETE {{baseUrl}}/products/1 HTTP/1.1
Authorization: Bearer {{adminToken}}


